# 复制为 .env 后按需填写；本地开发可以全部留空（有安全的默认值）

# --- 安全 ---
# 生产必填：django-admin generate_password 30
DJANGO_SECRET_KEY=
# 生产必填，逗号分隔：www.example.com,example.com
DJANGO_ALLOWED_HOSTS=

# --- 数据库 ---
# 留空=本地 SQLite（db.sqlite3）；测试始终用内存 SQLite，与此配置无关
# 生产示例：postgres://wenqu:密码@127.0.0.1:5432/wenqu
DATABASE_URL=

# --- 站点 ---
# 注册/找回密码邮件里的链接前缀
SITE_BASE_URL=http://127.0.0.1:8000

# --- 邮件 ---
# 留空时开发环境把邮件打印到控制台，不会真的发送
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# --- 仅生产（settings.prod）---
# 放在 Nginx 等反代之后才需要 True
USE_X_FORWARDED_HOST=False
# 默认 True：非 HTTPS 请求跳转；反代已终结 TLS 且不想再跳转时设 False
SECURE_SSL_REDIRECT=True
# HSTS 秒数，0 表示关闭
SECURE_HSTS_SECONDS=31536000
# 根日志级别：DEBUG / INFO / WARNING
DJANGO_LOG_LEVEL=INFO
